# 선택 기능을 연결할 때만 값을 입력하세요. 샘플 데모 실행에는 API 키가 필요하지 않습니다.
SEOUL_OPEN_API_KEY=
# 내려받은 원본 파일의 로컬 경로. 비워 두면 샘플 adapter만 사용합니다.
SEOUL_TREE_DATA_PATH=
SEOUL_SHADE_DATA_PATH=
SEOUL_HEATING_DATA_PATH=
SEOUL_STREETLIGHT_DATA_PATH=
# 서울 열린데이터광장 API 상세 화면에서 확인한 정확한 서비스명을 입력합니다.
SEOUL_BIKE_API_SERVICE=
# 공공데이터포털에서 활용 신청 후 발급된 일반 인증키(Encoding 아님)를 입력합니다.
KMA_DATA_API_KEY=
VWORLD_API_KEY=
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LOCAL_REPORT_DB_PATH=data/local/monthly_report.sqlite3
